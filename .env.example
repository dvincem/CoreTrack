# Copy this file to .env and fill in your values before deploying.

# API server port (default: 3000)
PORT=3000

# Set to 'production' when the server is internet-facing
NODE_ENV=development

# JWT signing secret — generate a strong random value:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# Admin account (env-var based, not in DB). Use a strong alphanumeric password.
TH_USERNAME=admin
TH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Superadmin account — highest privilege, keep strictly confidential
TH_SUPERADMIN_USERNAME=superadmin
TH_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS: comma-separated list of allowed origins (no trailing slashes)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Cloud Storage off-site backup (optional — leave blank to skip)
# GCS_BUCKET_NAME=your-bucket-name
# GCS_KEY_FILE=/path/to/service-account-key.json
